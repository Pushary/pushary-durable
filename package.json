{
  "name": "@pushary/durable",
  "version": "0.1.2",
  "description": "Durable human-in-the-loop for Inngest, Temporal, and Vercel Workflow: park your workflow until a real human approves on their phone, resume on a signed webhook.",
  "author": "Pushary <business@pushary.com>",
  "homepage": "https://pushary.com/human-in-the-loop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pushary/pushary-durable.git"
  },
  "bugs": {
    "url": "https://github.com/Pushary/pushary-durable/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@pushary/server": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pushary",
    "durable",
    "inngest",
    "temporal",
    "vercel-workflow",
    "human-in-the-loop",
    "hitl",
    "agent",
    "approval",
    "workflow",
    "webhook"
  ]
}
